---
layout: layouts/base.njk
mainClass: main--landing
lang: en
alternateLang: ko
alternateUrl: /
---
{# 영어 홈 - 히어로 + featuredEn + 3개 카테고리 섹션 (realestate 제외) #}
{# showInEnglish 기본값 규칙: 명시값 우선, 미지정 시 koreaOnly의 반대 (inEnglishHome 필터) #}
{% set t = i18n.en %}
{% set cardLang = 'en' %}

<section class="home-hero">
  <div class="home-hero__inner">
    <h1 class="home-hero__title">{{ t['home.heroTitle'] }}</h1>
    <p class="home-hero__subtitle">{{ t['home.heroSubtitle'] }}</p>
  </div>
</section>

<section class="home-section">
  <div class="home-section__inner">
    <h2 class="home-section__title">{{ t['home.section.featured'] }}</h2>
    <div class="app-grid app-grid--featured">
      {% for app in apps %}
        {% if app.featuredEn and not app.hidden %}
          {% set cardApp = app %}
          {% include "app-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="home-section home-section--alt">
  <div class="home-section__inner">
    <h2 class="home-section__title">{{ t['home.section.weatherRoad'] }}</h2>
    <div class="app-grid app-grid--small">
      {% for app in apps %}
        {% if app.category == 'weather-road' and not app.hidden and (app | inEnglishHome) %}
          {% set cardApp = app %}
          {% include "app-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="home-section">
  <div class="home-section__inner">
    <h2 class="home-section__title">{{ t['home.section.dailyTool'] }}</h2>
    <div class="app-grid app-grid--small">
      {% for app in apps %}
        {% if app.category == 'daily-tool' and not app.hidden and (app | inEnglishHome) %}
          {% set cardApp = app %}
          {% include "app-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="home-section home-section--alt">
  <div class="home-section__inner">
    <h2 class="home-section__title">{{ t['home.section.learning'] }}</h2>
    <div class="app-grid app-grid--small">
      {% for app in apps %}
        {% if app.category == 'learning' and not app.hidden and (app | inEnglishHome) %}
          {% set cardApp = app %}
          {% include "app-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

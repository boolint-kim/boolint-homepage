---
layout: layouts/base.njk
mainClass: main--landing
lang: ko
alternateLang: en
alternateUrl: /en/
---
{# 한국어 홈 - 히어로 + 카테고리 섹션 #}
{% set t = i18n.ko %}
{% set cardLang = 'ko' %}

<section class="home-hero">
  <img src="/assets/images/home/banner.png?v=20260513b" alt="{{ t['home.heroTitle'] }}" class="home-hero__banner">
</section>

<section class="home-section">
  <div class="home-section__inner">
    <h2 class="home-section__title">{{ t['home.section.featured'] }}</h2>
    <div class="app-grid app-grid--featured">
      {% for app in apps %}
        {% if app.category == 'featured' %}
          {% set cardApp = app %}
          {% include "app-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="home-section home-section--alt">
  <div class="home-section__inner">
    <h2 class="home-section__title">{{ t['home.section.weather'] }}</h2>
    <div class="app-grid app-grid--small">
      {% for app in apps | sort(attribute="name.ko") %}
        {% if app.category == 'weather' %}
          {% set cardApp = app %}
          {% include "app-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="home-section">
  <div class="home-section__inner">
    <h2 class="home-section__title">{{ t['home.section.realestateTax'] }}</h2>
    <div class="app-grid app-grid--small">
      {% for app in apps | sort(attribute="name.ko") %}
        {% if app.category == 'realestate-tax' %}
          {% set cardApp = app %}
          {% include "app-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="home-section home-section--alt">
  <div class="home-section__inner">
    <h2 class="home-section__title">{{ t['home.section.tool'] }}</h2>
    <div class="app-grid app-grid--small">
      {% for app in apps | sort(attribute="name.ko") %}
        {% if app.category == 'tool' %}
          {% set cardApp = app %}
          {% include "app-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

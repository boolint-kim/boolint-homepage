---
layout: layouts/base.njk
mainClass: main--landing
lang: ko
alternateLang: en
alternateUrl: /en/
---
{# 한국어 홈 - 히어로 + featured + 4개 카테고리 섹션 #}
{# 카테고리 내부 정렬: apps.json 배열 순서 (sort 없음) #}
{% set t = i18n.ko %}
{% set cardLang = 'ko' %}

<section class="home-hero">
  <img src="/assets/images/home/banner.png?v=20260513b" alt="{{ t['home.heroTitle'] }}" class="home-hero__banner">
</section>

<section class="home-section">
  <div class="home-section__inner">
    <h2 class="home-section__title">{{ t['home.section.featured'] }}</h2>
    <div class="app-grid app-grid--featured">
      {% for app in apps %}
        {% if app.featured and not app.hidden %}
          {% set cardApp = app %}
          {% include "app-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="home-section home-section--alt">
  <div class="home-section__inner">
    <h2 class="home-section__title">{{ t['home.section.weatherRoad'] }}</h2>
    <div class="app-grid app-grid--small">
      {% for app in apps %}
        {% if app.category == 'weather-road' and not app.hidden %}
          {% set cardApp = app %}
          {% include "app-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="home-section">
  <div class="home-section__inner">
    <h2 class="home-section__title">{{ t['home.section.realestate'] }}</h2>
    <div class="app-grid app-grid--small">
      {% for app in apps %}
        {% if app.category == 'realestate' and not app.hidden %}
          {% set cardApp = app %}
          {% include "app-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="home-section home-section--alt">
  <div class="home-section__inner">
    <h2 class="home-section__title">{{ t['home.section.dailyTool'] }}</h2>
    <div class="app-grid app-grid--small">
      {% for app in apps %}
        {% if app.category == 'daily-tool' and not app.hidden %}
          {% set cardApp = app %}
          {% include "app-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="home-section">
  <div class="home-section__inner">
    <h2 class="home-section__title">{{ t['home.section.learning'] }}</h2>
    <div class="app-grid app-grid--small">
      {% for app in apps %}
        {% if app.category == 'learning' and not app.hidden %}
          {% set cardApp = app %}
          {% include "app-card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

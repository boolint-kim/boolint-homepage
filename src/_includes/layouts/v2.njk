<!DOCTYPE html>
<html lang="{{ lang or 'ko' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {# 페이지 제목 #}
  <title>{% if title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>

  {# SEO 메타 #}
  <meta name="description" content="{{ description or i18n[lang or 'ko']['siteDescription'] }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta name="theme-color" content="#0b1220">

  {# Open Graph #}
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or i18n[lang or 'ko']['siteDescription'] }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% if ogImage %}<meta property="og:image" content="{{ site.url }}{{ ogImage }}">{% endif %}

  {# 다국어 alternate 링크 #}
  {% if alternateLang %}
  <link rel="alternate" hreflang="{{ alternateLang }}" href="{{ site.url }}{{ alternateUrl }}">
  {% endif %}

  {# Favicon #}
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png">
  <link rel="apple-touch-icon" href="/favicon-192.png">

  {# 폰트 — Pretendard Variable (동적 서브셋, 쓰는 글자 범위만 받는다) #}
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">

  {# v2 디자인 시스템 — 옛 global/components.css 와 독립 #}
  <link rel="stylesheet" href="/assets/css/v2.css?v=20261015g">

  {# 페이지 전용 CSS — 프론트매터에 pageCss 를 준 페이지만 (예: /trend/) #}
  {% if pageCss %}<link rel="stylesheet" href="{{ pageCss }}">{% endif %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  {% include "v2/header.njk" %}

  <main class="main">
    {{ content | safe }}
  </main>

  {% include "v2/footer.njk" %}

  {# 페이지 전용 JS — defer 라 DOM 이 준비된 뒤 실행된다 #}
  {% if pageJs %}<script src="{{ pageJs }}" defer></script>{% endif %}
</body>
</html>

{# v2 공통 푸터 — 브랜드 한 줄 + 분야 링크 + 정보 #}
{% set t = i18n[lang or 'ko'] %}
{# es·cs 는 홈이 없어 영어 홈으로 보낸다 → 분야 이름도 영어 홈 것을 쓴다 #}
{% set homeLang = 'ko' if (lang or 'ko') == 'ko' else 'en' %}
{% set home = '/' if homeLang == 'ko' else '/en/' %}
{% set h = i18n[homeLang] %}

<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <a href="{{ home }}" class="footer__brand">
          <img src="/favicon-192.png" alt="" width="28" height="28">
          <span>Boolint</span>
        </a>
        <p class="footer__tag">{{ t['footer.tagline'] }}</p>
      </div>
      <div>
        <h2 class="footer__title">{{ t['footer.categories'] }}</h2>
        <ul class="footer__links">
          {# 앵커 #cat-<key> 는 홈 템플릿의 분야 id 와 짝이다 #}
          <li><a href="{{ home }}#cat-weather-road">{{ h['home.section.weatherRoad'] }}</a></li>
          {% if homeLang == 'ko' %}<li><a href="{{ home }}#cat-realestate">{{ h['home.section.realestate'] }}</a></li>{% endif %}
          <li><a href="{{ home }}#cat-daily-tool">{{ h['home.section.dailyTool'] }}</a></li>
          <li><a href="{{ home }}#cat-learning">{{ h['home.section.learning'] }}</a></li>
        </ul>
      </div>
      <div>
        <h2 class="footer__title">{{ t['footer.info'] }}</h2>
        <ul class="footer__links">
          <li><a href="{% if lang == 'en' %}/en{% elif lang == 'es' %}/es{% elif lang == 'cs' %}/cs{% endif %}/privacy/">{{ t['footer.privacy'] }}</a></li>
          <li><a href="{{ t['lang.switchUrl'] }}">{{ t['lang.switch'] }}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <span>{{ t['footer.copyright'] | replace('{year}', site.year) }}</span>
      <span>{{ t['footer.platforms'] }}</span>
    </div>
  </div>
</footer>

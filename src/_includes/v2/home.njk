{# v2 홈 본문 — 한국어(/)·영어(/en/) 공용. 페이지가 lang 과 copy(문구 묶음)를 set 한 뒤 include 한다
   필요한 변수: lang, copy = { lead, featuredH2, featuredSub, cats:[{key, desc}], cards:[{icon,title,text}],
                               heroShots:[l, c, r], statAreas, … } #}
{% import "v2/macros.njk" as m %}
{% set en = lang == 'en' %}
{% set t = i18n[lang] %}
{% set prefix = '/en/' if en else '/' %}
{% set list = apps | visibleIn(lang) %}
{% set featured = list | selectattr('featuredEn' if en else 'featured') %}
{% set catKeys = { 'weather-road': 'home.section.weatherRoad', 'realestate': 'home.section.realestate',
                   'daily-tool': 'home.section.dailyTool', 'learning': 'home.section.learning' } %}

{# ── 히어로 ─────────────────────────────────────────────── #}
<section class="hero dark">
  <div class="wrap hero__grid">
    <div>
      <span class="pill"><span class="pill__dot"></span>Boolint Apps · Android &amp; iOS</span>
      <h1 class="hero__title">{{ copy.h1 | safe }}</h1>
      <p class="lead hero__lead">{{ copy.lead | replace('{n}', list | length) }}</p>
      <div class="hero__actions">
        <a href="#featured" class="btn btn--light">{{ copy.btnFeatured }} <span class="btn__arrow">→</span></a>
        <a href="#apps" class="btn btn--ghost">{{ copy.btnAll | replace('{n}', list | length) }}</a>
      </div>
      <ul class="hero__stats">
        <li><span class="stat__num">{{ list | length }}</span><span class="stat__label">{{ copy.statApps }}</span></li>
        <li><span class="stat__num">2</span><span class="stat__label">{{ copy.statPlatforms }}</span></li>
        <li><span class="stat__num">{{ copy.cats | length }}</span><span class="stat__label">{{ copy.statAreas }}</span></li>
      </ul>
    </div>
    <div class="hero__visual" aria-hidden="true">
      <div class="phones">
        {% for s in copy.heroShots %}
        <img class="phone phone--{{ ['l', 'c', 'r'][loop.index0] }}" src="{{ s.src }}" alt="" width="{{ s.w }}" height="{{ s.h }}">
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{# ── 대표 앱 (벤토) — 앞의 2개가 large. 작은 타일이 홀수면 남는 칸을 "전체 앱" 타일로 채운다 ── #}
<section class="section" id="featured">
  <div class="wrap">
    <div class="section__row">
      <div class="section__head">
        <p class="eyebrow">{{ t['nav.featured'] }}</p>
        <h2>{{ copy.featuredH2 }}</h2>
        <p>{{ copy.featuredSub }}</p>
      </div>
      <a href="#apps" class="link-more">{{ copy.linkAll }}</a>
    </div>
    <div class="bento">
      {% for app in featured %}
      {{ m.tile(app, lang, prefix, t[catKeys[app.category]], loop.index0 < 2) }}
      {% endfor %}
      {% if featured.length > 2 and (featured.length - 2) % 2 == 1 %}
      <a class="tile tile--more" href="#apps">{{ copy.linkAll }}</a>
      {% endif %}
    </div>
  </div>
</section>

{# ── 전체 앱 (분야별) — #cat-<key> 는 푸터 분야 링크와 짝이다 ── #}
<section class="section section--soft" id="apps">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">{{ t['nav.all'] }}</p>
      <h2>{{ copy.allH2 }}</h2>
      <p>{{ copy.allSub }}</p>
    </div>
    <nav class="chips" aria-label="{{ copy.chipsLabel }}">
      {% for c in copy.cats %}<a class="chip" href="#cat-{{ c.key }}">{{ t[catKeys[c.key]] }}</a>{% endfor %}
    </nav>
    {% for c in copy.cats %}
    {% set catApps = list | inCategory(c.key) %}
    <div class="cat" id="cat-{{ c.key }}">
      <div class="cat__head">
        <h3 class="cat__title">{{ t[catKeys[c.key]] }}</h3>
        <span class="cat__count">{{ catApps | length }}</span>
        <p class="cat__desc">{{ c.desc }}</p>
      </div>
      <div class="app-list">
        {% for app in catApps %}{{ m.appItem(app, lang, prefix) }}{% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>

{# ── 만드는 방식 ────────────────────────────────────────── #}
<section class="section">
  <div class="wrap">
    <div class="section__head section__head--center">
      <p class="eyebrow">{{ copy.howEyebrow }}</p>
      <h2>{{ copy.howH2 }}</h2>
    </div>
    <div class="cards3">
      {% for c in copy.cards %}
      <div class="card">
        <div class="card__icon">{{ m.icon(c.icon) }}</div>
        <h3>{{ c.title }}</h3>
        <p>{{ c.text }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

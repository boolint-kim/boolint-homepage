{# v2 공통 헤더 — 반투명 고정 바. homeUrl 은 시안 기간에 /v2/ 를 가리키게 하려고 둔 변수 #}
{% set t = i18n[lang or 'ko'] %}
{% set prefix = '/en/' if lang == 'en' or lang == 'es' or lang == 'cs' else '/' %}
{% set home = homeUrl or prefix %}

<header class="header">
  <div class="wrap header__inner">
    <a href="{{ home }}" class="header__logo">
      <img src="/favicon-192.png" alt="" width="28" height="28">
      <span>Boolint</span>
    </a>
    <nav class="header__nav" aria-label="주 메뉴">
      <a href="{{ home }}#featured" class="header__link">{{ 'Featured' if lang == 'en' else '대표 앱' }}</a>
      <a href="{{ home }}#apps" class="header__link">{{ 'All apps' if lang == 'en' else '전체 앱' }}</a>
      <a href="{{ t['lang.switchUrl'] }}" class="header__lang">{{ t['lang.switch'] }}</a>
    </nav>
  </div>
</header>
